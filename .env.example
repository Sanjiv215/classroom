# Copy to .env and add your Gemini API key.
GEMINI_API=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required to enable authenticated external /api/v1/* endpoints.
APP_API_KEY=replace-with-a-long-random-key

# Optional: POST report.generated JSON events to this URL.
REPORT_WEBHOOK_URL=

# Optional local settings
# DATABASE_PATH=student_portal.db
# PORT=5000
